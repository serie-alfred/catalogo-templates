
CONTACT_EMAIL=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com

# Google Fonts (proxy em /gerador/api/fonts)
GOOGLE_FONTS_API_KEY=

# Preview compartilhável — Vercel KV / Upstash Redis (SOMENTE em produção).
# Em dev, os previews são salvos em arquivo local (.preview-store/), sem estas vars.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Keep-alive do banco do preview (cron da Vercel, ver vercel.json).
# Opcional: se definido, a Vercel envia Authorization: Bearer <valor> e a rota
# /api/keep-alive passa a exigir esse header.
CRON_SECRET=

# Login da agência no /gerador (src/lib/auth.ts). Em PRODUÇÃO, sem as três o
# editor fica FECHADO. Em dev, sem elas o login fica desligado (com aviso).
# O segredo assina o cookie de sessão: 32+ caracteres aleatórios.
ETEMAS_LOGIN_USER=
ETEMAS_LOGIN_PASSWORD=
ETEMAS_SESSION_SECRET=

# Site público — comercial no WhatsApp (src/lib/comercial.ts). Rodízio entre
# as pessoas da lista: "Nome:55DDDNUMERO,Nome:55DDDNUMERO". Vazio = os botões
# do comercial levam ao formulário (/#contato).
COMERCIAIS=

# Site público — mídia paga (src/lib/tracking). Cada um liga o seu script, só
# depois do aceite no banner de cookies. Vazios = nada carrega e o banner some.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
