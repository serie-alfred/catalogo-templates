{
  "descricao": "Modelo Checkout01 do E-temas. Fonte de verdade do contrato do modelo: papéis (formato ComponentVariable do catálogo, default = nível 3; `visibilidade` = guarda do nível 2, gate0 #14a), neutros fixos (sem painel nem herança), etapas, fontes, handles React, frames do Figma, slots e placeholders. NUNCA renomeie para manifest.json: o AssetRegistry do generator derruba o build com manifest desconhecido. Ver docs/contrato.md.",
  "id": "Checkout01",
  "contrato": 1,
  "prefixo": "ck01",
  "plataforma": "vtex",
  "arquivos": {
    "css": "checkout6-custom.css",
    "js": "checkout6-custom.js",
    "header": "checkout-header.html",
    "footer": "checkout-footer.html"
  },
  "etapas": [
    { "id": "carrinho", "hash": "#/cart", "passo": "carrinho", "etp": "ETP1", "figma": "carrinho" },
    { "id": "email", "hash": "#/email", "passo": "identificacao", "etp": "ETP2", "figma": "perfil", "nota": "o Figma não desenha o e-mail: vale o visual da ETP2 (perfil)" },
    { "id": "perfil", "hash": "#/profile", "passo": "identificacao", "etp": "ETP2", "figma": "perfil" },
    { "id": "entrega", "hash": "#/shipping", "passo": "identificacao", "etp": "ETP3", "figma": "entrega" },
    { "id": "pagamento", "hash": "#/payment", "passo": "pagamento", "etp": "ETP4", "figma": "pagamento" }
  ],
  "stepper": [
    { "id": "carrinho", "rotulo": "Carrinho" },
    { "id": "identificacao", "rotulo": "Identificação" },
    { "id": "pagamento", "rotulo": "Pagamento" },
    { "id": "confirmacao", "rotulo": "Confirmação", "classeBody": "body-checkout-confirmation", "nota": "só acende no Order Placed, onde o checkout6-custom.css não carrega: a regra mora no <style> do header" }
  ],
  "classes": {
    "etapa": "ck01-step-",
    "passo": "ck01-passo-",
    "nota": "o etapa.js grava html.ck01-step-<etapa> e html.ck01-passo-<passo> no <head>, a partir do hash; hash vazio = carrinho; hash desconhecido = nenhuma classe"
  },
  "fontes": {
    "familia": "Montserrat",
    "pesos": [400, 500, 600, 700],
    "pesosImport": [300, 400, 500, 600, 700],
    "tamanhos": [9, 10, 12, 14, 16],
    "nota": "o Open Sans que aparece 1× no Figma (23028:1027, ETP4 desktop) é descuido do arquivo: vale Montserrat"
  },
  "breakpoints": { "mobile": 767, "tablet": 1023 },
  "handles": [
    { "app": "vtex.omnishipping", "prefixo": "vtex-omnishipping-1-x-", "major": 1, "medido": "1.22.1" },
    { "app": "vtex.shipping-preview", "prefixo": "vtex-shipping-preview-0-x-", "major": 0, "medido": "0.15.0" },
    { "app": "vtex.pickup-points-modal", "prefixo": "vtex-pickup-points-modal-3-x-", "major": 3, "medido": "3.8.3" }
  ],
