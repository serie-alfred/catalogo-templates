  ],
  "slots": {
    "css": ["font-import", "tokens"],
    "js": ["config", "integracoes"],
    "header": ["tokens-header"],
    "footer": ["tokens-footer"]
  },
  "marcadores": {
    "header": ["{{ETC_LOGO_SRC}}"]
  },
  "placeholders": [
    { "id": "{{RAZAO_SOCIAL}}", "arquivo": "checkout-footer.html", "descricao": "razão social da loja, como está no CNPJ" },
    { "id": "{{CNPJ}}", "arquivo": "checkout-footer.html", "descricao": "CNPJ da loja, no formato 00.000.000/0000-00" },
    { "id": "{{AVISO_LEGAL}}", "arquivo": "checkout-footer.html", "descricao": "texto legal do rodapé (preços, promoções, endereço)" },
    { "id": "{{LOGO_SRC}}", "arquivo": "checkout-header.html", "descricao": "URL (https) do logo da loja", "quando": "só quando o config.json não traz logo" }
  ],
